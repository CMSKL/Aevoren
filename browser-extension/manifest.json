{
  "manifest_version": 3,
  "name": "Aevoren Background Browser",
  "version": "0.1.0",
  "description": "仅在你明确共享的标签页中执行后台浏览器操作。",
  "minimum_chrome_version": "124",
  "key": "",
  "permissions": ["activeTab", "tabs", "debugger", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "共享后台浏览器标签页" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*" }
}
